PORT=4000
DATABASE_URL="postgresql://user:password@host:port/dbname"
JWT_SECRET=your_jwt_secret

# Groq (OpenAI-compatible, free tier) - powers the chat agent in agent.service.ts
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Optional second Groq key; uses GROQ_CHAT_MODEL unless overridden
GROQ_2=your_backup_groq_api_key
GROQ_2_CHAT_MODEL=openai/gpt-oss-20b
# Gemini is the final provider fallback
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Optional second Gemini key; uses GEMINI_CHAT_MODEL unless overridden
GEMINI_BACKUP2=your_backup_gemini_api_key
GEMINI_BACKUP2_CHAT_MODEL=gemini-2.5-flash

# OpenAI - kept for reference only; not used by the agent anymore
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_environment
PINECONE_INDEX_NAME=your_index_name

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_token
WHATSAPP_PHONE_NUMBER_ID=your_id
WHATSAPP_APP_SECRET=your_secret
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_id
WHATSAPP_API_VERSION=v25.0

# WhatsApp send/receive provider: 'meta' (direct Graph API) or '360dialog' (BSP, no App Review needed)
WHATSAPP_PROVIDER=meta
D360_API_KEY=your_360dialog_api_key
D360_API_BASE_URL=https://waba-sandbox.360dialog.io/v1

# Shared secret 360dialog echoes back in a custom header on every webhook call - used to verify requests actually came from them
WEBHOOK_SHARED_SECRET=generate_a_random_secret

# Instagram / FB Graph API
INSTAGRAM_ACCESS_TOKEN=your_token
INSTAGRAM_APP_SECRET=your_secret
INSTAGRAM_VERIFY_TOKEN=your_verify_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_id
# Optional: how many recent IG posts to pull into RAG (default 25)
INSTAGRAM_MEDIA_LIMIT=25
FB_PAGE_ACCESS_TOKEN=your_token
FB_PAGE_ID=your_id

# Instagram OAuth (Instagram API with Instagram Login — App Review)
# IMPORTANT: use the Instagram App ID from
#   Meta → Your App → Instagram → API setup with Instagram Login
# (this is often DIFFERENT from the Facebook/Meta App ID)
INSTAGRAM_APP_ID=your_instagram_app_id
# Must be added EXACTLY under:
#   Meta → Instagram → API setup with Instagram Login → OAuth redirect URIs
# Do NOT only add it under Facebook Login → Valid OAuth Redirect URIs
# Prefer your public backend URL (Render), not localhost:
INSTAGRAM_REDIRECT_URI=https://your-backend.example.com/api/integrations/instagram/callback
# Where to send the browser after OAuth completes (Fiesta AI frontend)
FRONTEND_URL=http://localhost:5000
# Public backend URL used for webhooks and default redirect URI construction
BASE_URL=https://your-backend.example.com
# Optional Graph API version override for Instagram Login calls
INSTAGRAM_GRAPH_API_VERSION=v21.0

# M-PESA API
MPESA_CONSUMER_KEY=your_key
MPESA_CONSUMER_SECRET=your_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
# Daraja does not sign callbacks, so the URL itself carries a secret:
#   MPESA_CALLBACK_URL=https://your-backend.example.com/api/mpesa/callback/<MPESA_CALLBACK_SECRET>
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Required in production (at least 24 characters); with it unset the endpoint rejects every callback.
MPESA_CALLBACK_URL=your_callback_url
MPESA_CALLBACK_SECRET=
# Optional: comma-separated source IPs allowed to call the endpoint (use the addresses Safaricom gives you)
MPESA_CALLBACK_ALLOWED_IPS=
# Optional cap on callbacks per IP per minute (default 300)
MPESA_CALLBACKS_PER_IP_PER_MINUTE=300

# Web chat (POST /api/chat/session then POST /api/chat with X-Chat-Session header)
# Optional dedicated signing secret (at least 32 chars); defaults to a key derived from AUTH_JWT_SECRET.
CHAT_SESSION_SECRET=
CHAT_SESSIONS_PER_IP_PER_HOUR=10
CHAT_MESSAGES_PER_IP_PER_MINUTE=40
CHAT_MESSAGES_PER_IP_PER_DAY=500
CHAT_MESSAGES_PER_SESSION_PER_MINUTE=12
CHAT_MAX_MESSAGE_CHARS=1000

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
GOOGLE_CALENDAR_ID=your_email@gmail.com

# AI Token Budget & Rate Limiting
DAILY_TOKEN_CAP=50000
# Optional: comma-separated phone numbers exempt from the daily token cap (e.g. your test number)
EXEMPT_TOKEN_CAP_NUMBERS=254721840961

